# ─────────────────────────────────────────────────────────────────────────────
# Local development only.
#
# IMPORTANT: keep these in `.env.development.local`, NOT `.env.local`.
# Vite loads `.env.local` in EVERY mode, production builds included, so a flag
# left there ships to the live site. `.env.development.local` is read only by
# `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────

# Registers the /admin route. The panel has no authentication — a login form on
# a static site would be decoration, not security — so it must never be part of
# a public build.
VITE_ENABLE_ADMIN=true

# ─────────────────────────────────────────────────────────────────────────────
# Needed everywhere, including production.
#
# Set these as build environment variables on the hosting platform (Cloudflare
# Pages: Settings → Environment variables) — not just here. `.env.local` also
# works locally if you want the "add your favourite place" form to actually
# submit while developing.
# ─────────────────────────────────────────────────────────────────────────────

# Public submit URL for the "add your favourite place" form, from
# https://formspree.io (free tier is enough). Not a secret — it's baked into
# the client bundle — so there's no harm in it being visible in devtools.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# ─────────────────────────────────────────────────────────────────────────────
# SECRET — never set this through a VITE_* name and never commit a real value.
# A `VITE_` prefix means Vite bakes the value into the public client bundle;
# this key must instead stay server-side in functions/api/recommend.ts (a
# Cloudflare Pages Function). Set it ONLY in the Cloudflare dashboard —
# Settings → Environment variables → add it, then tick "Encrypt". It is never
# read from this file or from `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key powering the homepage's free-text "AI підбір" box
# (functions/api/recommend.ts). Get one at https://console.anthropic.com —
# this is a paid API, billed per request. Without it, the feature shows an
# honest "not configured" error instead of pretending to work.
ANTHROPIC_API_KEY=sk-ant-...
